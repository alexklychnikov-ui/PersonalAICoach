# =============================================================================
# Personal AI Coach — шаблон переменных окружения
# Скопируй в .env и заполни секреты локально:
#   copy env.example .env   (Windows)  /  cp env.example .env
# .env в git не коммитится.
# Prod VPS: 193.168.196.12 | ssh AIcareerСoach | https://aicareercoach.alexklyvibe.ru/
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=PersonalAICoach
APP_HOST=0.0.0.0
APP_PORT=8000
# Публичный URL (prod) — для Telegram webhook и ссылок в README
PUBLIC_BASE_URL=https://aicareercoach.alexklyvibe.ru
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_REDACT=true
TZ=Asia/Irkutsk

# --- Streamlit ---
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
# Внутренний URL API для UI (в Docker — имя сервиса)
API_BASE_URL=http://127.0.0.1:8000

# --- MongoDB ---
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=coach
MONGO_PASSWORD=change_me_mongo
MONGO_DB=personal_ai_coach
# Если задан — имеет приоритет над HOST/USER/...
# MONGO_URI=mongodb://coach:change_me_mongo@127.0.0.1:27017/personal_ai_coach?authSource=admin

# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=60
LLM_DAILY_BUDGET_USD=5
LLM_MAX_RETRIES=3

# --- Telegram (aiogram) ---
TELEGRAM_BOT_TOKEN=
# Твой Telegram user id (single-user: бот отвечает только тебе)
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_PATH=/webhook/tg
TELEGRAM_WEBHOOK_SECRET=
# true = webhook на PUBLIC_BASE_URL; false = polling (удобно локально)
TELEGRAM_USE_WEBHOOK=false

# --- hh.ru API (https://dev.hh.ru + https://api.hh.ru/openapi/redoc#section/Avtorizaciya) ---
# 1) Зарегистрируй приложение на https://dev.hh.ru
# 2) Для поиска вакансий: токен ПРИЛОЖЕНИЯ
#      python scripts/hh_get_token.py app
#    или скопируй access_token из https://dev.hh.ru/admin
# 3) Токен ПОЛЬЗОВАТЕЛЯ нужен только для откликов/резюме (не для MVP-поиска):
#      python scripts/hh_get_token.py authorize-url
#      python scripts/hh_get_token.py user --code <CODE>
HH_ENABLED=true
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_REDIRECT_URI=https://aicareercoach.alexklyvibe.ru/oauth/hh/callback
HH_USER_AGENT=PersonalAICoach/0.1 (alexandr_klychnikov@mail.ru)
HH_CACHE_TTL_SEC=3600

# --- Kwork (read-only; неофициальный API / pykwork) ---
KWORK_ENABLED=true
KWORK_LOGIN=
KWORK_PASSWORD=
# Категории биржи через запятую (ID из URL projects?fc=…)
KWORK_CATEGORY_IDS=39
KWORK_POLL_INTERVAL_SEC=900

# --- LightRAG via MCP (опционально) ---
KNOWLEDGE_BASE_ENABLED=false
MCP_LIGHTRAG_COMMAND=
# JSON-массив аргументов, например: ["-m","daniel_lightrag_mcp"]
MCP_LIGHTRAG_ARGS=
MCP_LIGHTRAG_ENV_LIGHTRAG_BASE_URL=http://127.0.0.1:9621
MCP_LIGHTRAG_API_KEY=
MCP_TIMEOUT_SEC=15
MCP_CIRCUIT_BREAKER_FAILURES=3

# --- Scheduler / worker ---
WORKER_ENABLED=true
CHECKIN_CRON=0 10 * * 1
# Часовой пояс для cron — TZ выше

# --- Security / edge (prod Caddy) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Секрет для внутренних вызовов bot/worker → API (если понадобится)
INTERNAL_API_KEY=

# --- Deploy (VPS) ---
# Используется скриптами деплоя; SSH Host из ~/.ssh/config (кириллическая С в имени)
DEPLOY_SSH_HOST=AIcareerСoach
DEPLOY_SSH_USER=root
DEPLOY_REMOTE_DIR=/opt/personal-ai-coach
DEPLOY_DOMAIN=aicareercoach.alexklyvibe.ru
DEPLOY_SERVER_IP=193.168.196.12
